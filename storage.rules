rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return signedIn()
        && request.auth.uid == 'Uf3s1aGgddagiK4YUEP4RequxTu2';
    }

    function approvedSubmission() {
      return resource.metadata.submissionId is string
        && firestore.exists(
          /databases/(default)/documents/photoSubmissions/$(resource.metadata.submissionId)
        )
        && firestore.get(
          /databases/(default)/documents/photoSubmissions/$(resource.metadata.submissionId)
        ).data.status == 'approved';
    }

    function validFileName(fileName) {
      return request.resource.metadata.submissionId is string
        && request.resource.metadata.submissionId.matches('[A-Za-z0-9_-]{1,80}')
        && (
          (request.resource.contentType == 'image/jpeg'
            && fileName == request.resource.metadata.submissionId + '.jpg')
          || (request.resource.contentType == 'image/png'
            && fileName == request.resource.metadata.submissionId + '.png')
          || (request.resource.contentType == 'image/webp'
            && fileName == request.resource.metadata.submissionId + '.webp')
        );
    }

    function validImageUpload(eventId, userId, fileName) {
      return signedIn()
        && request.auth.uid == userId
        && eventId == 'leigh-v-warrington-2026'
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.ownerId == request.auth.uid
        && request.resource.metadata.eventId == eventId
        && request.resource.metadata.moderationStatus == 'pending'
        && validFileName(fileName);
    }

    match /photoSubmissions/{eventId}/{userId}/{fileName} {
      allow get: if isModerator() || approvedSubmission();
      allow list: if false;
      allow create: if validImageUpload(eventId, userId, fileName);
      allow update, delete: if isModerator();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
