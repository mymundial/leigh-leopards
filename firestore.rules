rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return signedIn()
        && request.auth.uid == 'Uf3s1aGgddagiK4YUEP4RequxTu2';
    }

    function validStoragePath(submissionId) {
      return (
          request.resource.data.contentType == 'image/jpeg'
          && request.resource.data.storagePath ==
            'photoSubmissions/' + request.resource.data.eventId + '/' + request.auth.uid + '/' + submissionId + '.jpg'
        ) || (
          request.resource.data.contentType == 'image/png'
          && request.resource.data.storagePath ==
            'photoSubmissions/' + request.resource.data.eventId + '/' + request.auth.uid + '/' + submissionId + '.png'
        ) || (
          request.resource.data.contentType == 'image/webp'
          && request.resource.data.storagePath ==
            'photoSubmissions/' + request.resource.data.eventId + '/' + request.auth.uid + '/' + submissionId + '.webp'
        );
    }

    function validPhotoSubmission(submissionId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'ownerId',
          'eventId',
          'status',
          'supporterName',
          'storagePath',
          'originalFileName',
          'contentType',
          'fileSize',
          'createdAt',
          'consentVersion',
          'source',
          'clientVersion'
        ])
        && request.resource.data.id == submissionId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.eventId == 'leigh-v-warrington-2026'
        && request.resource.data.status == 'pending'
        && request.resource.data.supporterName is string
        && request.resource.data.supporterName.size() <= 30
        && request.resource.data.storagePath is string
        && request.resource.data.originalFileName is string
        && request.resource.data.originalFileName.size() <= 160
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && validStoragePath(submissionId)
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 15 * 1024 * 1024
        && request.resource.data.createdAt == request.time
        && request.resource.data.consentVersion == '2026-07-19'
        && request.resource.data.source == 'leigh-matchday-web'
        && request.resource.data.clientVersion in ['share-photos-pass-2', 'share-photos-pass-5c'];
    }

    match /adminUsers/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /photoSubmissions/{submissionId} {
      allow create: if signedIn() && validPhotoSubmission(submissionId);
      allow get, list: if isModerator() || resource.data.status == 'approved';
      allow update, delete: if isModerator();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isModerator();

      match /scores/{scoreId} {
        allow read: if true;
        allow create: if signedIn()
          && eventId == 'leigh-v-warrington-2026'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'playerName', 'score', 'createdAt'
          ])
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() >= 1
          && request.resource.data.playerName.size() <= 24
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 9999
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isModerator();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
